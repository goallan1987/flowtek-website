---
import Icon from './Icon.astro';
import { business } from '../data/business.js';

interface Props { heading?: string; body?: string; suburb?: string }
const {
  heading = 'Got a problem right now?',
  body = business.emergencyLine,
  suburb = '',
} = Astro.props;
const smsBody = encodeURIComponent(business.smsBody + suburb);
---
<section class="cta-band on-dark">
  <div class="container cta-band__inner">
    <div>
      <h2>{heading}</h2>
      <p style="margin-top:16px">{body}</p>
      <p style="margin-top:24px">
        <a class="phone-big" href={business.phoneHref}>
          <Icon name="phone" size={28} />{business.phone}
        </a>
      </p>
    </div>
    <div class="btn-row" style="flex-direction:column;align-items:stretch">
      <a class="btn btn--primary" href={business.phoneHref}>
        <Icon name="phone" size={18} />Call {business.phone}
      </a>
      <a class="btn btn--ghost-light" href={`${business.smsHref}?&body=${smsBody}`}>
        <Icon name="message" size={18} />Text us instead
      </a>
      <a class="btn btn--ghost-light" href="/contact/">Fill in the short form</a>
    </div>
  </div>
</section>
