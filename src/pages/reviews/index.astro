---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import { business } from '../../data/business.js';
import { reviews } from '../../data/reviews.js';
import ArtHero from '../../components/ArtHero.astro';
import heroArt from '../../assets/hero/flowtek-services-customer-reviews-plumber-yeppoon.jpg';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { photos } from '../../data/photos.js';
---
<Base
  title="Reviews | Flowtek Services, Plumber Yeppoon & Rockhampton"
  description="Google reviews for Flowtek Services from customers across Yeppoon, Rockhampton and the Capricorn Coast, quoted exactly as they were written."
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Reviews' }]} />

  <ArtHero
    img={heroArt}
    alt="Painted illustration of Jason Breingan of Flowtek Services in the charcoal polo with the orange collar, shaking hands with a homeowner at her front door, the job finished and the site left clean"
    eyebrow="In their words, not ours"
    heading="Reviews"
    lede="Every quote on this page is copied exactly from a review published on our Google Business Profile. Nothing has been shortened, tidied or corrected."
    actions={false}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {reviews.map((r) => (
          <article class="review">
            <blockquote><p>{r.text}</p></blockquote>
            <div class="review__by">
              {r.name}
              <span class="review__src">Google review, {r.date}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>


  <section class="section section--mist">
    <div class="container container--narrow">
      <div class="callout" style="background:var(--white)">
        <h2 style="font-size:1.25rem">Two things we want to be straight about</h2>
        <p style="font-size:.9375rem">
          We have not printed a star rating or a review count on this page. That figure
          moves on its own, and a number typed into a web page stops being true the
          moment somebody leaves a review. Go and look at the live profile if you want
          the current one.
        </p>
        <p style="font-size:.9375rem;margin-top:12px">
          Several of these reviews mention how quickly we turned up. That is what
          happened on those days, for those customers. It is not a promise. Our
          emergency response runs during active business hours, and we would rather
          tell you that here than have you find out the hard way.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="rev-svc">
    <div class="container">
      <div class="section-head">
        <h2 id="rev-svc">What they called us out for</h2>
        <p>The six things we do, with a photograph of each.</p>
      </div>
      <ServiceCards />
    </div>
  </section>

  <CtaBand heading="Want us to have a look?" />
</Base>
