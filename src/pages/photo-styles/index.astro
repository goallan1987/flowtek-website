---
/**
 * Internal review page. noindex, and excluded from the sitemap.
 *
 * ROUND THREE: semi-realistic painted illustration, wide banner format.
 * Matched to a reference Gregory supplied (a Nextpoint Electrics hero banner).
 * The STYLE is matched, not the image or its composition.
 *
 * Round one (print/graphic) was rejected as cold and muted.
 * Round two (bright painterly) was rejected as over the top colourful.
 * Round three sits between them: naturalistic vivid colour, crisp linework,
 * realistic adult faces, smooth painted rendering, professional and warm.
 *
 * WHY THE LANDMARK SCENES ARE ALLOWED HERE.
 * The earlier objection was to PHOTOGRAPHIC composites implying Jason had been
 * somewhere he had not. A visibly painted illustration is not read as
 * documentary evidence by anyone. Illustrating Jason in a suburb he genuinely
 * services, meeting people, is ordinary brand illustration.
 *
 * The line that still holds: an illustration may never carry a caption that
 * asserts a specific job, a specific customer, or a specific review. It says
 * "we work here", which is true. Proof stays photographic.
 * See /OS/brand/photography.md and docs/outstanding-proof.md.
 */
import Base from '../../layouts/Base.astro';
import AnimPhoto from '../../components/AnimPhoto.astro';
import AnimPhotoScript from '../../components/AnimPhotoScript.astro';
import Icon from '../../components/Icon.astro';
import { business } from '../../data/business.js';

import b31 from '../../assets/art3/b-31-painted-semireal.jpg';
import b36 from '../../assets/art3/b-36-concept-art.jpg';
import b33 from '../../assets/art3/b-33-painted-comic.jpg';
import b32 from '../../assets/art3/b-32-graphic-novel.jpg';
import b39 from '../../assets/art3/b-39-editorial.jpg';
import b35 from '../../assets/art3/b-35-animation-bg.jpg';
import b40 from '../../assets/art3/b-40-vector-painted.jpg';
import b38 from '../../assets/art3/b-38-comic-halftone.jpg';
import b34 from '../../assets/art3/b-34-airbrush.jpg';
import b37 from '../../assets/art3/b-37-tourism-poster.jpg';

const alt = (style: string) =>
  `${style} illustration of Jason Breingan of Flowtek Services in the charcoal polo with the orange collar, holding a pipe wrench and talking with two homeowners, the Flowtek van behind them on the Yeppoon foreshore`;

const styles = [
  { n: '01', name: 'Painted semi-real', src: b31, anim: 'kenburns' as const, pick: true,
    what: 'Crisp linework over smooth painted rendering. Naturalistic vivid colour, realistic faces.',
    my: 'The closest match to your reference. Clean, professional, warm. This is the one I would build the site on.' },
  { n: '02', name: 'Concept-art painterly', src: b36, anim: 'parallax' as const, pick: true,
    what: 'Visible confident brushwork over solid drawing, richer light, more atmosphere.',
    my: 'Warmer and more premium than 01. The van livery came out closest to the real thing here. Best as a full-width hero.' },
  { n: '03', name: 'Painted comic', src: b33, anim: 'sunsweep' as const, pick: true,
    what: 'Stronger ink line over painted colour, harder sunlight, crisper shadows.',
    my: 'More graphic punch than 01 without losing the warmth. Holds up smaller, which matters for service cards.' },
  { n: '04', name: 'Graphic novel', src: b32, anim: 'hairline' as const,
    what: 'Confident ink outlines with flat-to-soft cel shading.',
    my: 'Cleaner and flatter. Cheapest to reproduce consistently across many images.' },
  { n: '05', name: 'Editorial', src: b39, anim: 'rack' as const,
    what: 'Soft painted rendering, delicate line, restrained naturalistic colour.',
    my: 'The most grown-up of the ten. Quietly premium. Least "trade", which may or may not be what you want.' },
  { n: '06', name: 'Animation background', src: b35, anim: 'duotone' as const,
    what: 'Luminous painted background with realistically proportioned figures.',
    my: 'The most beautiful light of the set. Slight risk of looking like a film still rather than a business.' },
  { n: '07', name: 'Vector-painted hybrid', src: b40, anim: 'edge' as const,
    what: 'Vector-sharp edges with smooth painted interiors.',
    my: 'The sharpest and most modern. Scales down better than any of the others.' },
  { n: '08', name: 'Comic with halftone', src: b38, anim: 'grain' as const,
    what: 'Crisp ink and naturalistic colour, subtle halftone in the shadows only.',
    my: 'A nod to print without the coldness of round one. Good middle ground.' },
  { n: '09', name: 'Airbrushed', src: b34, anim: 'rack' as const,
    what: 'Almost no linework, fine smooth gradients throughout.',
    my: 'Very polished. Can read a little soft and corporate next to the others.' },
  { n: '10', name: 'Tourism poster', src: b37, anim: 'kenburns' as const,
    what: 'Mid-century Australian poster warmth with modern painted figures.',
    my: 'The most distinctly Queensland. A charming outlier rather than a system.' },
];
---
<Base
  title="Artwork styles, internal review | Flowtek Services"
  description="Ten semi-realistic painted banner illustrations of Jason, for internal review."
  noindex={true}
>
  <section class="section">
    <div class="container">
      <div class="section-head" style="max-width:860px">
        <span class="eyebrow">Internal review &middot; 10 styles &middot; round three</span>
        <h1>Painted banner illustrations</h1>
        <p>
          Matched to the reference you sent: semi-realistic painted illustration,
          crisp linework, naturalistic colour, realistic faces, wide banner
          format. Round one was too cold, round two was too colourful. This sits
          between them.
        </p>
      </div>

      <div class="callout" style="max-width:860px;margin-bottom:64px">
        <h2 style="font-size:1.0625rem">Four things worth knowing</h2>
        <p style="font-size:.9375rem">
          <strong>The first three are my picks,</strong> and 01 is the closest
          match to your reference. All ten are the same scene deliberately, so
          you are comparing style and nothing else.
        </p>
        <p style="font-size:.9375rem;margin-top:12px">
          <strong>Style matched, not the image.</strong> Your reference is
          Nextpoint Electrics' own artwork. I matched the medium and the
          treatment, not their composition, their landmark or their layout.
        </p>
        <p style="font-size:.9375rem;margin-top:12px">
          <strong>This unlocks the suburb idea, honestly.</strong> My objection
          before was to photographic composites implying Jason had been somewhere
          he had not. A visibly painted illustration is not read as evidence.
          Illustrating him at the Singing Ship, in a suburb he genuinely
          services, is ordinary brand illustration. So we can do all 27.
        </p>
        <p style="font-size:.9375rem;margin-top:12px">
          <strong>Where the line still sits.</strong> An illustration can say
          "we work here", because that is true. It can never carry a caption
          asserting a specific job, customer or review. Proof stays photographic.
        </p>
      </div>

      <div class="stack-lg">
        {styles.map((s, i) => (
          <article class="rule-top" style="padding-top:40px">
            <div style="display:flex;flex-wrap:wrap;gap:24px;align-items:flex-end;margin-bottom:24px">
              <span class="distance" style="border-top:0;padding-top:0;gap:16px;flex:none">
                <span class="distance__fig" style={`font-size:3rem;line-height:1;${s.pick ? 'color:var(--orange-deep)' : ''}`}>{s.n}</span>
                <span class="distance__meta" style="padding-bottom:0.35em">{s.name}</span>
              </span>
              {s.pick && (
                <p class="badge-credential" style="margin:0;font-size:1rem;padding:8px 16px">My pick</p>
              )}
            </div>

            <AnimPhoto
              src={s.src}
              alt={alt(s.name)}
              anim={s.anim}
              ratio="21x9"
              eager={i < 2}
              widths={[720, 1100, 1600, 2000]}
              sizes="(min-width: 1360px) 1280px, 94vw"
            />

            <div class="split" style="align-items:start;margin-top:24px">
              <div>
                <dt style="font-family:var(--font-heading);font-weight:700;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--slate)">The treatment</dt>
                <dd style="margin:4px 0 0">{s.what}</dd>
              </div>
              <div>
                <dt style="font-family:var(--font-heading);font-weight:700;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--slate)">My read</dt>
                <dd style="margin:4px 0 0;color:var(--slate)">{s.my}</dd>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="rule-top" style="padding-top:40px;margin-top:56px">
        <h2>Pick one and I will build the set</h2>
        <p style="margin-top:16px">
          Once you name the number I will render, in that one style:
        </p>
        <ul class="ticklist" style="margin-top:16px;max-width:70ch">
          <li><Icon name="tick" size={18} /><span>One banner per service, six in total, each showing that actual work</span></li>
          <li><Icon name="tick" size={18} /><span>One banner per suburb, twenty-seven in total, each at that suburb's real landmark</span></li>
          <li><Icon name="tick" size={18} /><span>A home hero, and Jason on his own for the About page</span></li>
        </ul>
        <p style="margin-top:16px">
          That is about 35 images at two credits each, so roughly 70 credits for
          the whole site in one consistent hand.
        </p>
        <p style="margin-top:16px">
          One caveat worth knowing up front: the van livery and the polo logo are
          generated text, so a few will come out slightly wrong and need a
          reroll. I will check every one before it goes near the site.
        </p>
        <p style="margin-top:24px">
          <a class="btn btn--primary" href={business.phoneHref}>
            <Icon name="phone" size={18} />{business.phone}
          </a>
        </p>
      </div>
    </div>
  </section>

  <AnimPhotoScript />
</Base>
