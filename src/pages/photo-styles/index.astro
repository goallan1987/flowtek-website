---
/**
 * Internal review page. noindex, and excluded from the sitemap.
 *
 * ARTWORK STYLES generated with Higgsfield (nano_banana_pro) from Jason's own
 * photographs, each with a subtle CSS motion treatment on top.
 *
 * Round one (the "print" set) was rejected: too graphic, too cool, too muted.
 * Round two is bright, warm and friendly, and is ordered with the PAINTERLY
 * family first because Gregory said the watercolour was closest.
 *
 * WHY THIS IS ALLOWED, when a composited landmark photo is not.
 * These are obviously, deliberately non-photographic. Nobody reads a watercolour
 * as documentary evidence. They are derived from Jason's real photographs, at
 * his own request, of himself, doing the work he actually does, in the uniform
 * he actually wears. That is illustration.
 *
 * The line: none of these may be captioned or placed so as to imply a job, a
 * suburb or a customer that does not exist. Brand artwork, not proof. Proof
 * stays photographic. See /OS/brand/photography.md and docs/outstanding-proof.md.
 *
 * PALETTE NOTE: /OS/brand/colours.md is Navy + Orange and the photography spec
 * is hard-sun documentary. This bright colourful direction is a deliberate
 * departure, approved by Gregory on 21/08/2026. The charcoal polo with the
 * orange collar is preserved in every image, so the uniform stays accurate.
 */
import Base from '../../layouts/Base.astro';
import AnimPhoto from '../../components/AnimPhoto.astro';
import AnimPhotoScript from '../../components/AnimPhotoScript.astro';
import Icon from '../../components/Icon.astro';
import { business } from '../../data/business.js';

/* Painterly family, the direction Gregory picked */
import p21 from '../../assets/art2/j-21-bright-watercolour.jpg';
import p29 from '../../assets/art2/j-29-watercolour-ink.jpg';
import p22 from '../../assets/art2/j-22-gouache.jpg';
import p16 from '../../assets/art2/j-16-gouache-editorial.jpg';
import p13 from '../../assets/art2/j-13-picture-book.jpg';
import p26 from '../../assets/art2/j-26-digital-painting.jpg';
import p23 from '../../assets/art2/j-23-acrylic.jpg';
import p28 from '../../assets/art2/j-28-impressionist.jpg';
import p24 from '../../assets/art2/j-24-pastel.jpg';
import p25 from '../../assets/art2/j-25-coloured-pencil.jpg';
import p27 from '../../assets/art2/j-27-marker.jpg';
import p30 from '../../assets/art2/j-30-collage-paint.jpg';

/* Character family, bright and friendly but not painted */
import c11 from '../../assets/art2/j-11-bright-flat.jpg';
import c12 from '../../assets/art2/j-12-3d-bright.jpg';
import c14 from '../../assets/art2/j-14-bright-cartoon.jpg';
import c19 from '../../assets/art2/j-19-retro-cartoon.jpg';
import c15 from '../../assets/art2/j-15-claymation.jpg';
import c20 from '../../assets/art2/j-20-inflatable.jpg';
import c17 from '../../assets/art2/j-17-sticker.jpg';
import c18 from '../../assets/art2/j-18-bright-isometric.jpg';

import jasonLaughing from '../../assets/jason-laughing.jpg';

const alt = (style: string) =>
  `${style} illustration of Jason Breingan of Flowtek Services, in the charcoal polo with the orange collar, holding a shovel and waving in a sunny Australian suburban garden`;

const painterly = [
  { n: '01', name: 'Bright watercolour', src: p21, anim: 'rack' as const, pick: true,
    what: 'Loose saturated washes, wet-in-wet bleeds, white paper glowing through.',
    my: 'The closest to what you liked, pushed much brighter. Warm, human, and it does not look like any other plumber in Queensland.' },
  { n: '02', name: 'Watercolour and ink', src: p29, anim: 'hairline' as const, pick: true,
    what: 'Bright washes with fine ink linework sitting slightly off the colour. Native garden, and a dog.',
    my: 'The friendliest of the twenty. The linework keeps it crisp enough to hold up small, which watercolour alone does not.' },
  { n: '03', name: 'Gouache', src: p22, anim: 'kenburns' as const, pick: true,
    what: 'Opaque matte paint, confident flat brushstrokes, chalky finish.',
    my: 'The most versatile. Bright and warm but still tidy enough for service cards and headers.' },
  { n: '04', name: 'Gouache and pencil', src: p16, anim: 'grain' as const,
    what: 'Painted shapes with coloured pencil hatching worked over the top.',
    my: 'More texture than 03, slightly more editorial. Good for longer pages.' },
  { n: '05', name: 'Picture book', src: p13, anim: 'duotone' as const,
    what: 'Warm gouache with visible brush texture and paper tooth. Whimsical.',
    my: 'Charming. Watch it does not tip into childish on a page about burst pipes.' },
  { n: '06', name: 'Digital painting', src: p26, anim: 'sunsweep' as const,
    what: 'Textured brushwork, warm rim light, dappled shade.',
    my: 'The richest and most polished. Least obviously hand-made, which cuts both ways.' },
  { n: '07', name: 'Acrylic impasto', src: p23, anim: 'parallax' as const,
    what: 'Thick loaded brush on canvas, colour mixed on the surface.',
    my: 'Real painterly energy. Heavy at small sizes, strong as a feature band.' },
  { n: '08', name: 'Impressionist', src: p28, anim: 'kenburns' as const,
    what: 'Broken colour in short dabs, no black anywhere, coloured shadows.',
    my: 'The most beautiful and the least legible. A hero, never a card.' },
  { n: '09', name: 'Soft pastel', src: p24, anim: 'rack' as const,
    what: 'Chalk on textured paper, finger-blended, bloomy light.',
    my: 'Gentle and warm. Softest of the set, which may read as too soft for a trade.' },
  { n: '10', name: 'Coloured pencil', src: p25, anim: 'grain' as const,
    what: 'Layered burnished pencil on cream, paper grain showing.',
    my: 'Quietly lovely. Understated, and it holds detail better than the wet media.' },
  { n: '11', name: 'Marker', src: p27, anim: 'edge' as const,
    what: 'Streaky alcohol marker with brush-pen line, colour running past the edges.',
    my: 'Fresh and immediate, sketchbook energy. The loosest of the painterly set.' },
  { n: '12', name: 'Paint collage', src: p30, anim: 'venetian' as const,
    what: 'Torn painted paper layered with crayon and gouache marks.',
    my: 'The most experimental. Great as one feature, wrong repeated.' },
];

const character = [
  { n: '13', name: 'Bright flat character', src: c11, anim: 'kenburns' as const,
    what: 'Rounded friendly vector, vivid palette, waving.',
    my: 'The workhorse if you want flat rather than painted.' },
  { n: '14', name: '3D character, bright', src: c12, anim: 'tilt' as const,
    what: 'Warm animated-film render, saturated and sunny.',
    my: 'Very likeable. Also what every trade brand is doing right now.' },
  { n: '15', name: 'Bright cartoon', src: c14, anim: 'sunsweep' as const,
    what: 'Bold outlines, flat bright fills, thumbs up.',
    my: 'High energy. Suits the emergency page.' },
  { n: '16', name: 'Retro cartoon', src: c19, anim: 'hairline' as const,
    what: '1960s animation warmth, mustard and teal and coral.',
    my: 'Genuine character. The most distinctive of the flat options.' },
  { n: '17', name: 'Claymation', src: c15, anim: 'parallax' as const,
    what: 'Real plasticine set with thumbprints and tool marks.',
    my: 'Delightful and completely ownable. Nobody else will have this.' },
  { n: '18', name: 'Soft inflatable', src: c20, anim: 'duotone' as const,
    what: 'Puffy rounded soft-toy forms, pastel-bright.',
    my: 'Extremely approachable. Possibly too soft for gas fitting.' },
  { n: '19', name: 'Sticker', src: c17, anim: 'edge' as const,
    what: 'Chunky die-cut character, glossy, big wave.',
    my: 'For small repeated use: favicon, 404, form confirmations.' },
  { n: '20', name: 'Bright isometric', src: c18, anim: 'venetian' as const,
    what: 'Colourful toy diorama of the whole job on a tile.',
    my: 'For explaining a process, not for a hero.' },
];
---
<Base
  title="Artwork styles, internal review | Flowtek Services"
  description="Twenty generated artwork treatments of Jason, for internal review."
  noindex={true}
>
  <section class="section">
    <div class="container">
      <div class="section-head" style="max-width:820px">
        <span class="eyebrow">Internal review &middot; 20 styles &middot; round two</span>
        <h1>Artwork styles, bright and friendly</h1>
        <p>
          Round one was too graphic and too muted, so this is a full reset:
          brighter, warmer, more colourful, and led by the painterly family
          because the watercolour was closest. Same source photo throughout, so
          the only variable is the style.
        </p>
      </div>

      <div class="split" style="align-items:start;margin-bottom:64px">
        <div class="callout">
          <h2 style="font-size:1.0625rem">Three things worth knowing</h2>
          <p style="font-size:.9375rem">
            <strong>The first three are my picks.</strong> Bright watercolour,
            watercolour and ink, and gouache. All three are warm, colourful and
            still legible at card size, which is where most of them fail.
          </p>
          <p style="font-size:.9375rem;margin-top:12px">
            <strong>This is a departure from the brand spec, deliberately.</strong>
            <code>colours.md</code> is navy and orange, and the photography spec
            is hard-sun documentary. These are bright and multicoloured. The
            charcoal polo with the orange collar is kept in every single one, so
            the uniform stays right even where the palette opens up.
          </p>
          <p style="font-size:.9375rem;margin-top:12px">
            <strong>Artwork is not proof.</strong> None of these gets captioned
            as a job, a suburb or a customer. The photographs keep doing the
            proving.
          </p>
        </div>
        <figure class="pa pa--4x3">
          <img
            src={jasonLaughing.src}
            width={jasonLaughing.width}
            height={jasonLaughing.height}
            alt="The source photograph: Jason Breingan laughing, leaning on a shovel beside an open trench on a suburban verge"
            loading="eager"
          />
          <figcaption
            style="position:absolute;left:0;right:0;bottom:0;padding:16px 20px;background:var(--scrim-heavy);color:var(--white);font-size:.875rem"
          >
            The source. Every style below comes from this photograph.
          </figcaption>
        </figure>
      </div>

      <h2 class="rule-top" style="padding-top:32px">Painted, 01 to 12</h2>
      <p class="muted" style="margin-top:12px;margin-bottom:48px;max-width:70ch">
        The direction you picked, in twelve media. Ordered strongest first.
      </p>

      <div class="stack-lg">
        {painterly.map((s, i) => (
          <article class="rule-top" style="padding-top:40px">
            <div class="split" style="align-items:start">
              <div>
                <span class="distance" style="border-top:0;padding-top:0;gap:16px">
                  <span class="distance__fig" style={`font-size:3rem;line-height:1;${s.pick ? 'color:var(--orange-deep)' : ''}`}>{s.n}</span>
                  <span class="distance__meta" style="padding-bottom:0.35em">{s.name}</span>
                </span>
                {s.pick && (
                  <p class="badge-credential" style="margin-top:16px;font-size:1rem;padding:8px 16px">
                    My pick
                  </p>
                )}
                <dl style="margin:24px 0 0">
                  <dt style="font-family:var(--font-heading);font-weight:700;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--slate)">The medium</dt>
                  <dd style="margin:4px 0 16px">{s.what}</dd>
                  <dt style="font-family:var(--font-heading);font-weight:700;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--slate)">My read</dt>
                  <dd style="margin:4px 0 0;color:var(--slate)">{s.my}</dd>
                </dl>
              </div>
              <AnimPhoto
                src={s.src}
                alt={alt(s.name)}
                anim={s.anim}
                ratio="4x3"
                eager={i < 2}
                widths={[420, 640, 900]}
                sizes="(min-width: 880px) 560px, 92vw"
              />
            </div>
          </article>
        ))}
      </div>

      <h2 class="rule-top" style="padding-top:32px;margin-top:80px">Character, 13 to 20</h2>
      <p class="muted" style="margin-top:12px;margin-bottom:48px;max-width:70ch">
        Bright and friendly, but drawn or built rather than painted. Here in case
        the painted direction is not it after all.
      </p>

      <div class="stack-lg">
        {character.map((s) => (
          <article class="rule-top" style="padding-top:40px">
            <div class="split" style="align-items:start">
              <div>
                <span class="distance" style="border-top:0;padding-top:0;gap:16px">
                  <span class="distance__fig" style="font-size:3rem;line-height:1">{s.n}</span>
                  <span class="distance__meta" style="padding-bottom:0.35em">{s.name}</span>
                </span>
                <dl style="margin:24px 0 0">
                  <dt style="font-family:var(--font-heading);font-weight:700;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--slate)">The style</dt>
                  <dd style="margin:4px 0 16px">{s.what}</dd>
                  <dt style="font-family:var(--font-heading);font-weight:700;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--slate)">My read</dt>
                  <dd style="margin:4px 0 0;color:var(--slate)">{s.my}</dd>
                </dl>
              </div>
              <AnimPhoto
                src={s.src}
                alt={alt(s.name)}
                anim={s.anim}
                ratio="4x3"
                widths={[420, 640, 900]}
                sizes="(min-width: 880px) 560px, 92vw"
              />
            </div>
          </article>
        ))}
      </div>

      <div class="rule-top" style="padding-top:40px;margin-top:56px">
        <h2>Tell me which one</h2>
        <p style="margin-top:16px">
          Give me the number. Once you pick, I will render the chosen style
          across the rest: one per service, the van, and Jason on his own for
          the About page, so the whole site is one consistent hand.
        </p>
        <p style="margin-top:16px">
          If none of these is right, say what is off and I will go again. Cheap
          to iterate, two credits an image.
        </p>
        <p style="margin-top:24px">
          <a class="btn btn--primary" href={business.phoneHref}>
            <Icon name="phone" size={18} />{business.phone}
          </a>
        </p>
      </div>
    </div>
  </section>

  <AnimPhotoScript />
</Base>
