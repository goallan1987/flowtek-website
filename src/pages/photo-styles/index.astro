---
/**
 * Internal review page. noindex, and excluded from the sitemap.
 *
 * TEN ARTWORK STYLES, generated with Higgsfield (nano_banana_pro) from Jason's
 * own photographs, each with a subtle CSS motion treatment on top.
 *
 * WHY THIS IS ALLOWED, when a composited landmark photo is not.
 * These are obviously, deliberately non-photographic. Nobody looks at a linocut
 * or a flat vector drawing and reads it as documentary evidence. They are
 * derived from Jason's real photographs, at his own request, of himself, doing
 * the work he actually does, in the uniform he actually wears. That is
 * illustration, which is what every trade brand uses.
 *
 * The line they must not cross: none of these may be captioned or placed so as
 * to imply a job, a suburb or a customer that does not exist. They are brand
 * artwork, not proof. Proof stays photographic. See /OS/brand/photography.md
 * and docs/outstanding-proof.md.
 */
import Base from '../../layouts/Base.astro';
import AnimPhoto from '../../components/AnimPhoto.astro';
import AnimPhotoScript from '../../components/AnimPhotoScript.astro';
import Icon from '../../components/Icon.astro';
import { business } from '../../data/business.js';

import art01 from '../../assets/art/jason-01-flat-vector.jpg';
import art02 from '../../assets/art/jason-02-comic-halftone.jpg';
import art03 from '../../assets/art/jason-03-screenprint-poster.jpg';
import art04 from '../../assets/art/jason-04-ink-watercolour.jpg';
import art05 from '../../assets/art/jason-05-decal-sticker.jpg';
import art06 from '../../assets/art/jason-06-papercut.jpg';
import art07 from '../../assets/art/jason-07-risograph.jpg';
import art08 from '../../assets/art/jason-08-3d-character.jpg';
import art09 from '../../assets/art/jason-09-linocut.jpg';
import art10 from '../../assets/art/jason-10-isometric.jpg';

import jasonLaughing from '../../assets/jason-laughing.jpg';

const alt = (style: string) =>
  `${style} illustration of Jason Breingan of Flowtek Services, in the charcoal polo with the orange collar, holding a shovel beside an open trench in an Australian suburban front yard`;

const styles = [
  {
    n: '01', name: 'Flat vector', src: art01, anim: 'kenburns' as const,
    what: 'Clean flat vector. Bold shapes, no gradients, navy and orange only.',
    use: 'The safest and most useful of the ten. Service card headers, the areas hub, anywhere a photo would be too heavy.',
    watch: 'Reads as a proper brand asset rather than a filter. This is the one I would put money on.',
  },
  {
    n: '02', name: 'Comic halftone', src: art02, anim: 'sunsweep' as const,
    what: 'Inked comic panel with visible halftone dots and off-register colour.',
    use: 'The emergency page, and the "before we get there" steps. It suits a story told in stages.',
    watch: 'Plenty of personality. Use it in one place or it starts to shout.',
  },
  {
    n: '03', name: 'Screenprint poster', src: art03, anim: 'hairline' as const,
    what: 'Vintage Australian travel poster. Layered flat inks, paper grain, slight misregistration.',
    use: 'The areas we serve hub, and the suburb pages. It is a coastal Queensland idiom and Flowtek is a coastal Queensland business.',
    watch: 'The most distinctly Australian of the ten, and the least like every other plumber site.',
  },
  {
    n: '04', name: 'Ink and watercolour', src: art04, anim: 'rack' as const,
    what: 'Loose pen linework with transparent washes bleeding past the lines.',
    use: 'The About page. It is the warmest and least corporate.',
    watch: 'Soft. It will not hold up against the hard-sun photographs on the same screen.',
  },
  {
    n: '05', name: 'Van decal', src: art05, anim: 'edge' as const,
    what: 'Thick single-weight outline, four flat colours, mascot proportions.',
    use: 'Small and repeated: favicons, the 404, form confirmations, a footer mark.',
    watch: 'Genuinely could be cut as vinyl for the van. That is a real second use.',
  },
  {
    n: '06', name: 'Cut paper', src: art06, anim: 'parallax' as const,
    what: 'Layered torn paper with real shadows between the layers.',
    use: 'A single feature band between sections.',
    watch: 'The depth is real, so it takes the parallax treatment better than any of the others.',
  },
  {
    n: '07', name: 'Risograph', src: art07, anim: 'grain' as const,
    what: 'Two inks only, navy and fluorescent orange, deliberately misregistered on off-white stock.',
    use: 'Section openers, or the reviews page.',
    watch: 'The only one that uses the exact brand pair and nothing else. Strongest graphic punch of the ten.',
  },
  {
    n: '08', name: '3D character', src: art08, anim: 'tilt' as const,
    what: 'Warm stylised 3D render, animated-feature look.',
    use: 'The home hero, if you want approachable over documentary.',
    watch: 'The most likeable and the most generic. Every trade brand is reaching for this right now.',
  },
  {
    n: '09', name: 'Linocut', src: art09, anim: 'venetian' as const,
    what: 'Hand-carved relief print. Black ink, one orange spot colour, cream stock.',
    use: 'Projects, or a print job: invoices, letterhead, a shirt.',
    watch: 'Works in one colour, which means it survives embroidery and signage. Worth knowing given there is still no vector logo master.',
  },
  {
    n: '10', name: 'Isometric diorama', src: art10, anim: 'duotone' as const,
    what: 'Tiny toy-like scene of the job on a floating tile.',
    use: 'Explaining a process. The emergency steps, or how a job runs.',
    watch: 'The only one that shows the whole job rather than the man. Good for diagrams, wrong for a hero.',
  },
];
---
<Base
  title="Artwork styles, internal review | Flowtek Services"
  description="Ten generated artwork treatments of Jason, for internal review."
  noindex={true}
>
  <section class="section">
    <div class="container">
      <div class="section-head" style="max-width:820px">
        <span class="eyebrow">Internal review &middot; 10 styles</span>
        <h1>Artwork styles</h1>
        <p>
          Ten illustration styles generated from Jason's own photographs, each
          with a subtle motion treatment on top. Same source photo, same pose,
          same uniform, so the only variable is the style.
        </p>
      </div>

      <div class="split" style="align-items:start;margin-bottom:64px">
        <div class="callout">
          <h2 style="font-size:1.0625rem">How to read this page</h2>
          <p style="font-size:.9375rem">
            <strong>Pick one, maybe two.</strong> These are strong styles. Two
            used consistently will look like a brand. Six will look like a
            software demo.
          </p>
          <p style="font-size:.9375rem;margin-top:12px">
            <strong>Artwork is not proof.</strong> None of these can be captioned
            as a job, a suburb or a customer. They are brand illustration. The
            photographs stay photographic and keep doing the proving.
          </p>
          <p style="font-size:.9375rem;margin-top:12px">
            <strong>They are all Jason.</strong> Same face, same charcoal polo
            with the orange collar, same shovel, same trench. Derived from his
            own photo, of himself, doing his own work.
          </p>
        </div>
        {/* The control image carries no treatment. It is the reference the ten
            styles are judged against, so it is always plainly visible. */}
        <figure class="pa pa--4x3">
          <img
            src={jasonLaughing.src}
            width={jasonLaughing.width}
            height={jasonLaughing.height}
            alt="The source photograph: Jason Breingan laughing, leaning on a shovel beside an open trench on a suburban verge"
            loading="eager"
          />
          <figcaption
            style="position:absolute;left:0;right:0;bottom:0;padding:16px 20px;background:var(--scrim-heavy);color:var(--white);font-size:.875rem"
          >
            The source. Every style below comes from this photograph.
          </figcaption>
        </figure>
      </div>

      <div class="stack-lg">
        {styles.map((s, i) => (
          <article class="rule-top" style="padding-top:40px">
            <div class="split" style="align-items:start">
              <div>
                <span class="distance" style="border-top:0;padding-top:0;gap:16px">
                  <span class="distance__fig" style="font-size:3rem;line-height:1">{s.n}</span>
                  <span class="distance__meta" style="padding-bottom:0.35em">{s.name}</span>
                </span>
                <dl style="margin:24px 0 0">
                  <dt class="k" style="font-family:var(--font-heading);font-weight:700;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--slate)">The style</dt>
                  <dd style="margin:4px 0 16px">{s.what}</dd>
                  <dt class="k" style="font-family:var(--font-heading);font-weight:700;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--slate)">Where it belongs</dt>
                  <dd style="margin:4px 0 16px">{s.use}</dd>
                  <dt class="k" style="font-family:var(--font-heading);font-weight:700;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--slate)">My read</dt>
                  <dd style="margin:4px 0 0;color:var(--slate)">{s.watch}</dd>
                  <dt class="k" style="font-family:var(--font-heading);font-weight:700;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--slate);margin-top:16px">Motion</dt>
                  <dd style="margin:4px 0 0;color:var(--slate)">{s.anim}</dd>
                </dl>
              </div>
              <AnimPhoto
                src={s.src}
                alt={alt(s.name)}
                anim={s.anim}
                ratio="4x3"
                eager={i < 2}
                widths={[420, 640, 900]}
                sizes="(min-width: 880px) 560px, 92vw"
              />
            </div>
          </article>
        ))}
      </div>

      <div class="rule-top" style="padding-top:40px;margin-top:56px">
        <h2>Tell me which one</h2>
        <p style="margin-top:16px">
          Give me the number and where it goes. If you want the chosen style
          rendered from the other photographs too, or from a specific service
          shot, say so and I will generate the set.
        </p>
        <p style="margin-top:24px">
          <a class="btn btn--primary" href={business.phoneHref}>
            <Icon name="phone" size={18} />{business.phone}
          </a>
        </p>
      </div>
    </div>
  </section>

  <AnimPhotoScript />
</Base>
