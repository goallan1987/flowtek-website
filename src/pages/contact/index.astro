---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import { business, smsText, emergencySteps } from '../../data/business.js';
import ArtHero from '../../components/ArtHero.astro';
import heroArt from '../../assets/hero/contact-flowtek-services-plumber-yeppoon.jpg';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { photos } from '../../data/photos.js';
---
<Base
  title="Contact Flowtek Services | Yeppoon Plumber | 0448 726 474"
  description="Ring, text or send the short form. Flowtek Services, licensed plumber and gas fitter based in Yeppoon, serving Rockhampton, Taranganba and the Capricorn Coast."
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact us' }]} />

  <ArtHero
    img={heroArt}
    alt="Painted illustration of Jason Breingan of Flowtek Services in the charcoal polo with the orange collar, standing beside the Flowtek van on the phone mid-conversation, explaining something, a notepad under his arm"
    eyebrow={business.areaLine}
    heading="Get in touch"
    lede="Three ways to reach us, and the phone is the fastest. If it is urgent, ring. If it is not, the form is fine and we will get back to you."
  />

  <section class="section">
    <div class="container split">
      <QuoteForm
        id="contact-form"
        heading="Send us the details"
        intro="Three fields we need, two that help. The make and age of a hot water unit, or where exactly the water is coming from, saves us both a trip."
      />
      <div>
        <h2 style="font-size:1.5rem">Straight to us</h2>
        <ul class="factlist" style="margin-top:24px">
          <li>
            <span class="k">Phone</span>
            <span class="v" style="font-size:1.375rem;font-family:var(--font-heading);font-weight:700">
              <a href={business.phoneHref}>{business.phone}</a>
            </span>
          </li>
          <li>
            <span class="k">Text message</span>
            <span class="v">
              <a href={`${business.smsHref}?&body=${encodeURIComponent(smsText())}`}>
                Text us your suburb and the problem
              </a>
            </span>
          </li>
          <li><span class="k">Based in</span><span class="v">Yeppoon, Queensland 4703</span></li>
          <li>
            <span class="k">Looking for work</span>
            <span class="v"><a href="/careers/plumbing-jobs-yeppoon/">We are hiring a plumber in Yeppoon</a></span>
          </li>
          <li><span class="k">Service area</span><span class="v">Yeppoon, Rockhampton, Taranganba and the Capricorn Coast</span></li>
          <li><span class="k">Trade</span><span class="v">{business.credential}</span></li>
          <li><span class="k">Emergency</span><span class="v">{business.emergencyLine}</span></li>
        </ul>

        <div class="callout" style="margin-top:32px">
          <h3 style="font-size:1.0625rem">A note on availability</h3>
          <p style="font-size:.9375rem">
            We have not put a response time on this page, because we have not promised
            one. Ring us and we will tell you what we can actually do and when.
          </p>
        </div>
      </div>
    </div>
  </section>

  <PhotoGallery
    items={[photos.vanSide, photos.vanBack, photos.jasonHeadshot]}
    eyebrow="What turns up"
    heading="The van, and the bloke driving it"
    intro="If we are coming to you, this is what pulls into the driveway."
  />

  <section class="section section--mist" aria-labelledby="con-svc">
    <div class="container">
      <div class="section-head">
        <h2 id="con-svc">What people usually ring about</h2>
        <p>If it is one of these, say so on the phone and we will know what to bring.</p>
      </div>
      <ServiceCards />
    </div>
  </section>

  <section class="section section--ink on-dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow eyebrow--on-dark">While you wait</span>
        <h2>Do this before we get there</h2>
        <p>It stops the damage, and it is worth knowing before you need it.</p>
      </div>
      <ul class="steps">
        {emergencySteps.map((e, i) => (
          <li>
            <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 style="font-size:1.25rem">{e.title}</h3>
            <ol style="list-style:decimal;margin-left:20px;color:rgba(255,255,255,.88)">
              {e.steps.map((st) => <li style="margin-bottom:6px">{st}</li>)}
            </ol>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
