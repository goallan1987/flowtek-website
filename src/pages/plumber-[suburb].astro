---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import Promises from '../components/Promises.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Reviews from '../components/Reviews.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CtaBand from '../components/CtaBand.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import { photos, photosForService, serviceCardPhoto } from '../data/photos.js';
import { serviceArt } from '../data/service-art.js';
import { business, serviceBySlug } from '../data/business.js';
import { suburbs, nearbyPages } from '../data/suburbs.js';


export function getStaticPaths() {
  return suburbs.map((s) => ({ params: { suburb: s.slug }, props: { s } }));
}

const { s } = Astro.props;

/* Every photograph below is a real Flowtek job photograph from the business's own
   media library. None is stock. Only the Taranganba image is tied to a named
   suburb, because that job is documented on the live site. The rest are captioned
   as Flowtek work without a location claim, because the location was not recorded.
   See the outstanding proof list in /docs/outstanding-proof.md. */
/* EVERY photograph on this page comes from src/data/photos.js, so the alt text
   and the caption are written once. They used to be re-typed here and had
   already drifted from the library copy.

   Three slots, and no photograph is allowed to fill two of them:
     hero     the charcoal polo shot, the uniform of record, same on every page
     feature  varies by the suburb's lead service
     gallery  three more, chosen below
   The service cards take their own photographs and are excluded from all three. */
const LIB = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/**/*.{jpg,jpeg,png}', { eager: true });
const resolve = (file: string) => LIB[`../assets/${file}`]?.default;
const ART = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/service-art/*.jpg', { eager: true });

const heroPhoto = photos.conduitRoughIn;

const cardFiles = new Set(
  Object.values(serviceCardPhoto).map((k: any) => (photos as any)[k]?.file)
);

const featurePhoto = (() => {
  if (s.hasRealJob) return photos.taranganbaDrainage;
  for (const slug of s.leadServices) {
    for (const ph of photosForService(slug, 4)) {
      if (ph.file === heroPhoto.file) continue;
      if (cardFiles.has(ph.file)) continue;
      return ph;
    }
  }
  return photos.drainageRiser;
})();

const lead = s.leadServices.map((slug: string) => serviceBySlug[slug]);

/* The three services this suburb is NOT led by. The section below used to
   repeat all six, so the top three appeared twice on the one page under a
   heading that said "everything else". */
const restSlugs = Object.keys(serviceBySlug).filter(
  (slug) => !s.leadServices.includes(slug)
);

/* Photograph for each lead service card. Chosen by SERVICE, never by suburb:
   the heading may say "in Taranganba", the picture never does. */
const cardPic = (slug: string) => {
  const e = (serviceArt as any)[slug];
  const img = e && ART[`../assets/service-art/${e.file}`]?.default;
  return img ? { img, alt: e.alt } : null;
};

/* Photographs chosen by this suburb's lead services, so neighbouring suburbs do
   not show an identical set. Taranganba additionally gets the one photograph on
   the site whose suburb is actually documented. */
/* The service cards on this page carry artwork now, so the gallery only has to
   avoid the hero and the feature photograph above it. */
const galleryItems = (() => {
  const onCards = new Set<string>();
  const pick = (skipCards: boolean) => {
    const seen = new Set<string>();
    const out: any[] = [];
    if (s.hasRealJob && featurePhoto.file !== photos.taranganbaDrainage.file) {
      out.push(photos.taranganbaDrainage); seen.add(photos.taranganbaDrainage.file);
    }
    for (const slug of s.leadServices) {
      for (const ph of photosForService(slug, 4)) {
        if (seen.has(ph.file)) continue;
        if (ph.file === heroPhoto.file || ph.file === featurePhoto.file) continue;
        if (skipCards && onCards.has(ph.file)) continue;
        seen.add(ph.file); out.push(ph);
        if (out.length >= 3) return out;
      }
    }
    return out;
  };
  const strict = pick(true);
  return strict.length >= 2 ? strict : pick(false);
})();
const neighbours = nearbyPages(s);
const smsBody = encodeURIComponent(business.smsBody + s.name);

/* Title kept under 60 characters and description under 160, so neither gets
   truncated in the result. Both carry "plumber {suburb}" and "plumbing", which
   are the two phrases this page is built to answer. */
const title = `Plumber ${s.name} | Plumbing & Gas Fitting | Flowtek`;
const longDesc = `Licensed plumber and gas fitter in ${s.name} ${s.postcode}. ${s.fault.title}, and what we do about it. Call ${business.phone}.`;
const description =
  longDesc.length <= 158
    ? longDesc
    : `Licensed plumber and gas fitter in ${s.name} ${s.postcode}. Hot water, drains, gas and renovations. Call ${business.phone}.`;
---
<Base
  title={title}
  description={description}
  page="suburb"
  suburbSlug={s.slug}
  smsSuburb={s.name}
  faq={s.faq}
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Areas we serve', href: '/areas-we-serve/' },
      { label: s.name },
    ]}
  />

  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="container hero__inner">
      <div>
        <p class="hero__area">
          <Icon name="pin" size={14} /> {s.name} {s.postcode}
          {s.area !== s.name && <> &middot; {s.area}</>}
        </p>
        <h1>Plumber in {s.name}</h1>
        <p class="lede hero__lede">
          {s.intro}{' '}
          {s.base
            ? 'Licensed plumber and gas fitter, water and gas from the one trade, and the site gets cleaned up before we leave.'
            : 'We are a licensed plumber and gas fitter based in Yeppoon, covering the water and the gas from the one trade.'}
        </p>

        <div class="btn-row hero__actions">
          <a class="btn btn--primary" href={business.phoneHref}>
            <Icon name="phone" size={18} />Call {business.phone}
          </a>
          <a class="btn btn--ghost-light" href={`${business.smsHref}?&body=${smsBody}`}>
            <Icon name="message" size={18} />Text us
          </a>
          <a class="btn btn--ghost-light" href="#quote">Short form</a>
        </div>

        <Promises />
      </div>

      <figure class="hero__figure">
        <Image
          src={resolve(heroPhoto.file)}
          alt={heroPhoto.alt}
          widths={[420, 640, 900]}
          sizes="(min-width: 900px) 460px, 92vw"
          quality={72}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- ================= THE LOCAL SUBSTANCE ================= -->
  <section class="section" aria-labelledby="local-heading">
    <div class="container split">
      <div>
        <span class="eyebrow">{s.council} &middot; {s.postcode}</span>
        <h2 id="local-heading">What we know about the pipes in {s.name}</h2>
        <div class="prose" style="margin-top:24px">
          <p>{s.local}</p>
        </div>

        <div class="callout" style="margin-top:32px">
          <h3 style="font-size:1.125rem">{s.fault.title}</h3>
          <p>{s.fault.body}</p>
        </div>
      </div>

      <div>
        <figure class="media-round">
          <Image
            src={resolve(featurePhoto.file)}
            alt={featurePhoto.alt}
            widths={[400, 560, 780]}
            sizes="(min-width: 880px) 560px, 92vw"
            quality={72}
            loading="lazy"
          />
          <figcaption
            style="padding:16px 20px;background:var(--mist);font-size:.875rem;line-height:1.5;color:var(--ink)"
          >
            {featurePhoto.caption}
            {!s.hasRealJob && (
              <span style="display:block;margin-top:8px;color:var(--slate)">
                A Flowtek job. We have not recorded which street it was on, so we
                are not going to claim it was this one.
              </span>
            )}
          </figcaption>
        </figure>

        {/* "From our base" is filtered out here: the distance numeral in the
            access section states it, and stating it twice on one page is noise. */}
        <ul class="factlist" style="margin-top:32px">
          {s.facts.filter(([k]: [string, string]) => k !== 'From our base').map(([k, v]: [string, string]) => (
            <li><span class="k">{k}</span><span class="v">{v}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= ACCESS ================= -->
  <section class="section section--tight section--mist" aria-labelledby="access-heading">
    <div class="container">
      <div class="split">
        <div>
          {/* The signature move. The number that decides whether someone rings,
              set as a composition element rather than buried in a sentence. */}
          <div class={s.base ? 'distance distance--base' : 'distance'}>
            <span class="distance__fig">
              {s.base ? 'Base' : s.km}{!s.base && <span class="distance__unit">km</span>}
            </span>
            <span class="distance__meta">
              {s.base ? 'Yeppoon is where we work from' : `by road from our Yeppoon base`}
            </span>
          </div>
          <h2 id="access-heading" style="margin-top:32px">Access and parking in {s.name}</h2>
        </div>
        <div>
          <p style="color:var(--ink)">{s.access}</p>
          <p style="margin-top:16px;color:var(--ink)">
            <strong>That figure is a distance, not a promise about the clock.</strong>
            {' '}{business.emergencyLine} Ring us and we will tell you what we can
            actually do and when.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section class="section" aria-labelledby="svc-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Six services</span>
        <h2 id="svc-heading">Plumbing and gas services in {s.name}</h2>
        <p>
          Six things, and the three at the top are what {s.name} rings us about most.
          Every one of them is done by a licensed plumber and gas fitter, and the site
          gets cleaned up before we leave.
        </p>
      </div>

      <div class="grid grid--3" style="margin-bottom:32px">
        {lead.map((svc: any, i: number) => {
          const p = cardPic(svc.slug);
          return (
            <article class:list={['card', 'card--linked', p && 'card--photo']}>
              {p && (
                <div class="card__media">
                  <Image
                    src={p.img}
                    alt={p.alt}
                    widths={[400, 640, 900]}
                    sizes="(min-width:960px) 380px, (min-width:640px) 45vw, 92vw"
                    quality={74}
                    loading="lazy"
                  />
                  <span class="card__rank" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                </div>
              )}
              <div class="card__body">
                {!p && <span class="numeral" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>}
                <h3 style="font-size:1.25rem">{svc.name} in {s.name}</h3>
                <p>{svc.hook} {svc.blurb}</p>
                <a class="card__link card__stretch" href={`/services/${svc.slug}/`}>
                  More on {svc.navName.toLowerCase()} <Icon name="arrow" size={16} />
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <h3 style="font-size:1.125rem;margin:48px 0 16px">Everything else we cover in {s.name}</h3>
      <ServiceCards suburb={s.name} only={restSlugs} />
    </div>
  </section>

  <PhotoGallery
    items={galleryItems}
    eyebrow="Real jobs, real photos"
    heading={`The work ${s.name} rings us about`}
    intro="Photographs from Flowtek jobs. Not stock, not generated, and captioned only with what is actually in the frame."
    mist={true}
  />

  <!-- ================= PROOF ================= -->
  <section class="section section--navy on-dark" aria-labelledby="proof-heading">
    <div class="container split">
      <div>
        <h2 id="proof-heading">Have we worked in {s.name}?</h2>
        <p style="margin-top:16px">
          {s.hasRealJob
            ? `Yes, and it is on this page. The stormwater job above was done here in ${s.name}, and it is written up on our projects page with the fault, the cause and the fix.`
            : `We work across ${s.area} from Yeppoon, but we are not going to put a made-up job or a borrowed photo on this page to prove it. If we have done work at your place in ${s.name}, a Google review helps your neighbours far more than anything we could write here.`}
        </p>
        <div class="btn-row" style="margin-top:24px">
          <a class="btn btn--primary" href="/projects/">See a job written up</a>
          <a class="btn btn--ghost-light" href="/reviews/">Read the reviews</a>
        </div>
      </div>
      <div>
        {/* ------------------------------------------------------------------
            OPEN PROOF SLOT for {s.name}.
            To close it, Jason supplies: (1) one job photograph taken in this
            suburb, named suburb-service-YYYYMMDD.jpg per /OS/brand/photography.md,
            and (2) the name and month of one customer in this suburb who has left
            a Google review, with their permission to show the suburb.
            Until both arrive, nothing is claimed here. Do not fill this with a
            photo from another suburb. See /docs/outstanding-proof.md.
        ------------------------------------------------------------------ */}
        <ul class="ticklist">
          <li><Icon name="tick" size={20} /><span>{business.credential}</span></li>
          <li><Icon name="tick" size={20} /><span>Based in Yeppoon, not a call centre in another state</span></li>
          <li><Icon name="tick" size={20} /><span>Water and gas from the one trade on the same job</span></li>
          <li><Icon name="tick" size={20} /><span>We turn up on time, and we clean up afterwards</span></li>
        </ul>
      </div>
    </div>
  </section>

  <Reviews
    seed={s.slug}
    tags={s.reviewTags}
    heading={`What customers said about the work`}
    intro="Google reviews from across Yeppoon, Rockhampton and the Capricorn Coast, quoted exactly as they were written."
  />

  <!-- ================= FAQ ================= -->
  <section class="section" aria-labelledby="faq-heading">
    <div class="container container--narrow">
      <div class="section-head">
        <h2 id="faq-heading">{s.name} questions we actually get asked</h2>
      </div>
      <div class="faq">
        {s.faq.map((f: { q: string; a: string }) => (
          <details>
            <summary>{f.q}</summary>
            <div><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= FORM ================= -->
  <section class="section section--mist" id="quote" aria-labelledby="quote-form-heading">
    <div class="container split">
      <div>
        <QuoteForm
          suburb={s.name}
          service={s.leadServices[0]}
          heading={`Get a ${s.name} plumber out`}
          intro={`Three fields we need, two that help. If it is urgent, ring instead, it is faster.`}
        />
      </div>
      <div>
        <h3>Three ways to get us</h3>
        <ul class="factlist" style="margin-top:16px">
          <li>
            <span class="k">Ring</span>
            <span class="v"><a href={business.phoneHref}>{business.phone}</a></span>
          </li>
          <li>
            <span class="k">Text</span>
            <span class="v"><a href={`${business.smsHref}?&body=${smsBody}`}>Send a text with your suburb</a></span>
          </li>
          <li>
            <span class="k">Form</span>
            <span class="v">The one on the left. Three fields.</span>
          </li>
          <li>
            <span class="k">Emergency</span>
            <span class="v">{business.emergencyLine}</span>
          </li>
        </ul>
        <p style="margin-top:24px" class="badge-credential">{business.credential}</p>
      </div>
    </div>
  </section>

  <!-- ================= NEARBY ================= -->
  {neighbours.length > 0 && (
    <section class="section section--tight" aria-labelledby="near-heading">
      <div class="container">
        <div class="section-head" style="margin-bottom:24px">
          <span class="eyebrow">{neighbours.length} nearby suburbs</span>
          <h2 id="near-heading" style="font-size:1.5rem">We cover the streets either side of {s.name} too</h2>
        </div>
        <ul class="arealist">
          {neighbours.map((n: any) => (
            <li>
              <a href={`/plumber-${n.slug}/`}>
                <Icon name="pin" size={16} />
                Plumber {n.name}
                <span class="km">{n.km} km</span>
              </a>
            </li>
          ))}
          <li>
            <a href="/areas-we-serve/">
              <Icon name="arrow" size={16} />
              Every area we serve
            </a>
          </li>
        </ul>
      </div>
    </section>
  )}

  <CtaBand
    heading={`Need a plumber in ${s.name} today?`}
    suburb={s.name}
  />
</Base>
