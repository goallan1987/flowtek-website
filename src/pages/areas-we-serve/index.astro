---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { business } from '../../data/business.js';
import { coastSuburbs, rockySuburbs, suburbs } from '../../data/suburbs.js';

const total = suburbs.length;
---
<Base
  title="Areas We Serve | Plumber Yeppoon & Rockhampton | Flowtek"
  description={`Flowtek covers ${total} suburbs across Yeppoon, Rockhampton and the Capricorn Coast. Find your suburb and what the plumbing actually does there.`}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Areas we serve' }]} />

  <section class="hero">
    <div class="container hero__inner" style="grid-template-columns:1fr">
      <div style="max-width:820px">
        <p class="hero__area">100% Local. 100% Committed.</p>
        <h1>Areas we serve</h1>
        <p class="lede hero__lede">
          {business.areaLine}, from a base in Yeppoon. Every suburb below has its own
          page, and every one of those pages says something specific: the age of the
          housing, what breaks first there, what the ground does when it rains, and how
          far it is from us.
        </p>
        <div class="btn-row hero__actions">
          <a class="btn btn--primary" href={business.phoneHref}>
            <Icon name="phone" size={18} />Call {business.phone}
          </a>
          <a class="btn btn--ghost-light" href="#not-listed">Suburb not listed?</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="coast">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Livingstone Shire</span>
        <h2 id="coast">The Capricorn Coast</h2>
        <p>
          Salt in the air, cut-and-fill blocks, and a wet season that turns up every
          year between November and April. Distances are by road from our Yeppoon base.
        </p>
      </div>
      <ul class="arealist">
        {coastSuburbs.map((s) => (
          <li>
            <a href={`/plumber-${s.slug}/`}>
              <Icon name="pin" size={16} />
              Plumber {s.name}
              <span class="km">{s.base ? 'our base' : `${s.km} km`}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="rocky">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Rockhampton Regional</span>
        <h2 id="rocky">Rockhampton and around</h2>
        <p>
          A city where the plumbing problem changes with the decade the house went up,
          and where the summer heat is harder on an outdoor hot water unit than
          anything the coast throws at it.
        </p>
      </div>
      <ul class="arealist">
        {rockySuburbs.map((s) => (
          <li>
            <a href={`/plumber-${s.slug}/`}>
              <Icon name="pin" size={16} />
              Plumber {s.name}
              <span class="km">{s.km} km</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="not-listed" aria-labelledby="nl">
    <div class="container split">
      <div>
        <span class="eyebrow">If you are not on the list</span>
        <h2 id="nl">Ring and ask. We will tell you straight.</h2>
        <div class="prose" style="margin-top:24px">
          <p>
            We have given a page to the suburbs where there is something genuinely
            useful to say about the plumbing. That is not the same as the only places we
            go. We also cover the smaller localities in between: Barmaryee, Meikleville
            Hill, Rosslyn, Pacific Heights, Inverness, Mulara, Hidden Valley, Woodbury,
            Byfield, Koongal, Lakes Creek, Depot Hill, Port Curtis and Rockyview among
            them.
          </p>
          <p>
            If your address is not on this page, the useful thing is to ring rather than
            guess. We would rather tell you no once than take a job we cannot get to.
          </p>
        </div>
        <p style="margin-top:32px">
          <a class="btn btn--primary" href={business.phoneHref}>
            <Icon name="phone" size={18} />Call {business.phone}
          </a>
        </p>
      </div>
      <QuoteForm
        id="areas-form"
        heading="Or ask us here"
        intro="Type your suburb in, even if it is not on the list, and we will tell you honestly whether we come out there."
      />
    </div>
  </section>

  <CtaBand />
</Base>
