---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import Promises from '../../components/Promises.astro';
import Reviews from '../../components/Reviews.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import { business, services } from '../../data/business.js';
import { serviceContent } from '../../data/service-content.js';
import { byRank } from '../../data/suburbs.js';

import imgHotWater from '../../assets/electric-storage-hot-water-system-installation-yeppoon.jpg';
import imgRiser from '../../assets/blocked-drain-pvc-riser-inspection-approved-yeppoon.png';
import imgConduit from '../../assets/bathroom-renovation-plumbing-rough-in-yeppoon.jpg';
import imgCommercialGas from '../../assets/commercial-kitchen-gas-fitting-rockhampton-yeppoon.png';
import imgRegulator from '../../assets/gas-regulator-installation-test-points-yeppoon.png';
import imgGasTrench from '../../assets/gas-line-service-trench-marker-tape-yeppoon.png';

import ArtHero from '../../components/ArtHero.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import { photos, serviceDetailPhoto, photosForService } from '../../data/photos.js';
import artHotWater from '../../assets/hero/hot-water-system-installation-repairs-yeppoon-rockhampton.jpg';
import artDrains from '../../assets/hero/blocked-drains-drain-cleaning-yeppoon-rockhampton.jpg';
import artReno from '../../assets/hero/bathroom-kitchen-renovation-plumbing-yeppoon-rockhampton.jpg';
import artGas from '../../assets/hero/gas-fitting-gas-installation-yeppoon-rockhampton.jpg';
import artBackflow from '../../assets/hero/backflow-tmv-testing-yeppoon-rockhampton.jpg';
import artEmergency from '../../assets/hero/emergency-plumber-yeppoon-rockhampton.jpg';

/* One illustration per service, each showing that actual work. Illustration
   positions, it does not prove: no caption here claims a specific job. */
const artBySlug: Record<string, { img: any; alt: string }> = {
  'hot-water': { img: artHotWater, alt: 'Painted illustration of Jason kneeling beside an instantaneous gas hot water unit on a brick wall, spanner in hand, the old storage cylinder on the pavers beside him' },
  'blocked-drains': { img: artDrains, alt: 'Painted illustration of Jason crouched over an open drainage inspection point in a suburban lawn, feeding a drain camera down the line with the screen beside him' },
  renovations: { img: artReno, alt: 'Painted illustration of Jason fitting copper pipework into an open timber-framed wall in a half-finished bathroom renovation, before the plasterboard goes on' },
  'gas-fitting': { img: artGas, alt: 'Painted illustration of Jason connecting a gas line to a stainless steel cooktop in a bright kitchen, spanner on the fitting and a leak test bottle beside him' },
  'backflow-tmv-testing': { img: artBackflow, alt: 'Painted illustration of Jason testing a brass backflow prevention device on an exterior wall, a test kit with gauges connected and a test report under his arm' },
  'emergency-plumbing': { img: artEmergency, alt: 'Painted illustration of Jason crouched at a water meter at the front boundary, turning the water off at the isolation tap, the Flowtek van at the kerb behind him' },
};

export function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.slug }, props: { svc: s } }));
}

const { svc } = Astro.props;
const c = serviceContent[svc.slug as keyof typeof serviceContent];

const media: Record<string, { img: any; alt: string; cap: string }> = {
  'hot-water': {
    img: imgHotWater,
    alt: 'A mains pressure electric storage hot water unit installed against a brick wall, with new copper pipework, a tempering valve on the outlet and lagged flow and return lines running back into the house',
    cap: 'A mains pressure electric storage unit in and connected, tempering valve on the outlet. On this coast the fittings and the valve usually go well before the tank does.',
  },
  'blocked-drains': {
    img: imgRiser,
    alt: 'A capped PVC drainage riser standing in an open trench, carrying a green inspection sticker approving the pipework to be covered up',
    cap: 'Drainage riser inspected and approved before backfill. The sticker is the sign-off.',
  },
  renovations: {
    img: imgConduit,
    alt: 'A Flowtek plumber in a charcoal polo with an orange collar, kneeling in a timber framed room and threading conduit through a wall frame, tools laid out on the slab',
    cap: 'Rough-in on a timber frame. Get this right and the tiler never has to be called back.',
  },
  'gas-fitting': {
    img: imgCommercialGas,
    alt: 'Copper gas lines with braided flexible connectors and restraint chains running to commercial cooking appliances in a stainless steel commercial kitchen',
    cap: 'Commercial kitchen gas fit-off, with the flexible connectors restrained the way they have to be.',
  },
  'backflow-tmv-testing': {
    img: imgRegulator,
    alt: 'A gas regulator mounted on an exterior wall with copper lines running to it and capped test points',
    cap: 'Anything with a test point on it has a test interval attached to it.',
  },
  'emergency-plumbing': {
    img: imgGasTrench,
    alt: 'An open service trench across a lawn beside a retaining wall, with yellow warning marker tape laid along the bottom of the trench',
    cap: 'Getting to a buried line is most of the job. Locating it first is what keeps the trench short.',
  },
};
const m = media[svc.slug];
const otherServices = services.filter((s) => s.slug !== svc.slug);

/* An inline photograph inside the prose. It is the SECOND photo for this
   service, so the gallery further down still has something new to show. A long
   read on a phone needs something to break it up, and the honest thing to break
   it up with is the work itself. */
const inlineLib = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/**/*.{jpg,jpeg,png}', { eager: true });
const detailKey = (serviceDetailPhoto as any)[svc.slug];
const detailEntry = (photos as any)[detailKey];

/* The gallery further down must not repeat the inline photograph. Two services
   only have two photographs to their name, and for those the gallery wins:
   two proof photos side by side beat one photo shown twice. */
const allForService = photosForService(svc.slug, 4);

/* The other five cards now carry artwork, not photographs, so the only thing
   the gallery has to avoid is the inline photograph directly above it. */
const galleryPhotos = allForService.filter((x: any) => x.key !== detailKey);
const useInline = galleryPhotos.length >= 2;

const inlinePhoto = useInline && detailEntry
  ? { img: inlineLib[`../../assets/${detailEntry.file}`]?.default, alt: detailEntry.alt, caption: detailEntry.caption }
  : null;

const topSuburbs = byRank.slice(0, 12);
---
<Base
  title={c.metaTitle}
  description={c.metaDesc}
  page="service"
  serviceSlug={svc.slug}
  faq={c.faq}
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services/' },
      { label: svc.navName },
    ]}
  />

  <ArtHero
    img={artBySlug[svc.slug].img}
    alt={artBySlug[svc.slug].alt}
    eyebrow={business.areaLine}
    heading={c.h1}
    lede={`${c.lede} ${svc.blurb}`}
    promises={true}
  />

  <section class="section">
    <div class="container split" style="align-items:start">
      <div class="prose">
        {c.body.map((block: any, bi: number) => (
          <div>
            <h2>{block.h}</h2>
            {block.p.map((para: string) => <p>{para}</p>)}
            {bi === 0 && inlinePhoto?.img && (
              <figure class="prose-fig">
                <Image
                  src={inlinePhoto.img}
                  alt={inlinePhoto.alt}
                  widths={[520, 800, 1100]}
                  sizes="(min-width:960px) 620px, 92vw"
                  quality={76}
                  loading="lazy"
                />
                <figcaption>{inlinePhoto.caption}</figcaption>
              </figure>
            )}
            {block.table && (
              <ul class="factlist" style="margin:24px 0">
                {block.table.map(([k, v]: [string, string]) => (
                  <li><span class="k">{k}</span><span class="v" style="font-size:1rem">{v}</span></li>
                ))}
              </ul>
            )}
            {block.after && <p>{block.after}</p>}
          </div>
        ))}
      </div>

      <aside style="position:sticky;top:100px">
        <div class="card card--plain" style="border-top:5px solid var(--orange)">
          <h3 style="font-size:1.125rem">What this covers</h3>
          <ul class="ticklist" style="margin-top:16px">
            {svc.items.map((i: string) => (
              <li><Icon name="tick" size={18} /><span style="font-size:.9375rem">{i}</span></li>
            ))}
          </ul>
          <a class="btn btn--primary" href={business.phoneHref} style="margin-top:24px">
            <Icon name="phone" size={18} />{business.phone}
          </a>
        </div>

        {(svc.slug === 'gas-fitting' || svc.slug === 'backflow-tmv-testing') && (
          <div class="callout" style="margin-top:24px">
            <h3 style="font-size:1rem">Doing this on a commercial site?</h3>
            <p style="font-size:.9375rem">
              Fitout, commercial kitchens, services pipework and the annual testing that
              comes with a date on it.
            </p>
            <p style="font-size:.9375rem;margin-top:12px">
              <a href="/commercial/">Commercial plumbing and gas</a>
            </p>
          </div>
        )}

        <div class="callout" style="margin-top:24px">
          <h3 style="font-size:1rem">Where we do it</h3>
          <p style="font-size:.9375rem">
            {business.areaLine}, from our base in Yeppoon.
          </p>
          <p style="font-size:.9375rem;margin-top:12px">
            <a href="/areas-we-serve/">See every suburb we cover</a>
          </p>
        </div>
      </aside>
    </div>
  </section>

  <PhotoGallery
    items={(useInline ? galleryPhotos : allForService).slice(0, 3)}
    eyebrow="Real jobs"
    heading={`${svc.name} we have actually done`}
    intro="Photographs from Flowtek jobs, not stock. What the work looks like when it is going properly."
    mist={true}
  />

  <!-- Suburb links. These are the pages that carry the local detail, so this is
       the internal link that actually helps a searcher, not a keyword dump. -->
  <section class="section section--mist" aria-labelledby="where">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{topSuburbs.length} suburbs</span>
        <h2 id="where">{svc.name}, where you are</h2>
        <p>
          Each suburb page says what the housing, the ground and the water actually do
          there, and what that means for this kind of work.
        </p>
      </div>
      <ul class="arealist">
        {topSuburbs.map((s) => (
          <li>
            <a href={`/plumber-${s.slug}/`}>
              <Icon name="pin" size={16} />
              {svc.navName} in {s.name}
              <span class="km">{s.base ? 'our base' : `${s.km} km`}</span>
            </a>
          </li>
        ))}
      </ul>
      <p style="margin-top:32px">
        <a class="btn btn--secondary" href="/areas-we-serve/">All areas we serve</a>
      </p>
    </div>
  </section>

  <Reviews seed={svc.slug} tags={[svc.slug, ...svc.slug.split('-')]} mist={false} />

  <section class="section section--mist" aria-labelledby="faq-h">
    <div class="container container--narrow">
      <div class="section-head">
        <h2 id="faq-h">{svc.navName} questions we get asked</h2>
      </div>
      <div class="faq">
        {c.faq.map((f: { q: string; a: string }) => (
          <details>
            <summary>{f.q}</summary>
            <div><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="quote" aria-labelledby="quote-form-heading">
    <div class="container split">
      <QuoteForm
        service={svc.slug}
        heading={`Get a price on ${svc.name.toLowerCase()}`}
        intro="Tell us what is going on and we will come back to you with what the job actually involves."
      />
      <div>
        <h2 style="font-size:1.25rem">While we are there</h2>
        <p style="font-size:.9375rem;margin-top:12px">
          We are licensed for water and for gas, so if something else is playing up
          while we are on site, say so on the form. It saves you a second call out.
        </p>
        <p style="margin-top:24px" class="badge-credential">{business.credential}</p>
      </div>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="other-five">
    <div class="container">
      <div class="section-head">
        <h2 id="other-five">The other five</h2>
        <p>The rest of what we do, with a photograph of each so you can see what it looks like.</p>
      </div>
      <ServiceCards only={otherServices.map((o: any) => o.slug)} />
    </div>
  </section>

  <CtaBand heading={`Need ${svc.navName.toLowerCase()} sorted?`} />
</Base>
