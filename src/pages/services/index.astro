---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import Reviews from '../../components/Reviews.astro';
import CtaBand from '../../components/CtaBand.astro';
import { business, services } from '../../data/business.js';
import ArtHero from '../../components/ArtHero.astro';
import heroArt from '../../assets/hero/h-services.jpg';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { photos } from '../../data/photos.js';
---
<Base
  title="Plumbing & Gas Services | Yeppoon & Rockhampton | Flowtek"
  description="Six services across Yeppoon, Rockhampton and the Capricorn Coast: hot water, blocked drains, renovations, gas fitting, backflow and TMV testing, emergency."
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />

  <ArtHero
    img={heroArt}
    alt="Painted illustration of Jason Breingan of Flowtek Services in the charcoal polo with the orange collar, at the open rear doors of the Flowtek van, reaching for a tool from shelves of copper fittings and a drain camera reel"
    eyebrow={business.areaLine}
    heading="Six things, done properly"
    lede="Whether it is a blocked dunny, leaky taps, gas issues or more, we have got you covered. We are licensed for water and for gas, which on a kitchen with a gas cooktop means one trade instead of two."
  />

  <section class="section" aria-labelledby="all-svc">
    <div class="container">
      <div class="section-head">
        <h2 id="all-svc">What we get called for</h2>
      </div>
      <ServiceCards />
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head">
        <h2>What each one actually involves</h2>
      </div>
      <div class="grid grid--2">
        {services.map((s) => (
          <article class="card card--plain">
            <h3 style="font-size:1.25rem">{s.name}</h3>
            <p style="margin-top:12px">{s.blurb}</p>
            <ul class="ticklist" style="margin-top:16px">
              {s.items.map((i) => (
                <li><Icon name="tick" size={16} /><span style="font-size:.9375rem">{i}</span></li>
              ))}
            </ul>
            <a class="card__link" href={`/services/${s.slug}/`}>
              Read more <Icon name="arrow" size={16} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <PhotoGallery
    items={[photos.hotWaterInstalled, photos.drainageInstall, photos.conduitRoughIn, photos.commercialGas, photos.backflowTest, photos.serviceTrench]}
    eyebrow="One photo per service"
    heading="What each of the six actually looks like"
    intro="Real photographs from Flowtek jobs, one for each thing we do."
    mist={true}
  />

  <Reviews seed="services" mist={false} />
  <CtaBand />
</Base>
