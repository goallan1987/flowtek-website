---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import Reviews from '../../components/Reviews.astro';
import CtaBand from '../../components/CtaBand.astro';
import { business, services } from '../../data/business.js';
import ArtHero from '../../components/ArtHero.astro';
import heroArt from '../../assets/hero/plumbing-gas-services-yeppoon-rockhampton.jpg';
import { Image } from 'astro:assets';
import { photos, serviceDetailPhoto } from '../../data/photos.js';

/* A SECOND photograph per service, different from the one on the cards above,
   so the page does not show the same six pictures twice on one screen. */
const LIBRARY = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/**/*.{jpg,jpeg,png}', { eager: true });
const pic = (slug: string) => {
  const e = (photos as any)[(serviceDetailPhoto as any)[slug]];
  const img = e && LIBRARY[`../../assets/${e.file}`]?.default;
  return img ? { img, alt: e.alt, caption: e.caption } : null;
};
---
<Base
  title="Plumbing & Gas Services | Yeppoon & Rockhampton | Flowtek"
  description="Six services across Yeppoon, Rockhampton and the Capricorn Coast: hot water, blocked drains, renovations, gas fitting, backflow and TMV testing, emergency."
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />

  <ArtHero
    img={heroArt}
    alt="Painted illustration of Jason Breingan of Flowtek Services in the charcoal polo with the orange collar, at the open rear doors of the Flowtek van, reaching for a tool from shelves of copper fittings and a drain camera reel"
    eyebrow={business.areaLine}
    heading="Six things, done properly"
    lede="Whether it is a blocked dunny, leaky taps, gas issues or more, we have got you covered. We are licensed for water and for gas, which on a kitchen with a gas cooktop means one trade instead of two."
  />

  <section class="section" aria-labelledby="all-svc">
    <div class="container">
      <div class="section-head">
        <h2 id="all-svc">What we get called for</h2>
      </div>
      <ServiceCards />
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head">
        <h2>What each one actually involves</h2>
      </div>
      <div class="grid grid--2">
        {services.map((s) => {
          const p = pic(s.slug);
          return (
            <article class:list={['card', 'card--plain', p && 'card--media']}>
              {p && (
                <div class="card__side">
                  <Image
                    src={p.img}
                    alt={p.alt}
                    widths={[320, 520, 760]}
                    sizes="(min-width:960px) 220px, (min-width:560px) 30vw, 92vw"
                    quality={74}
                    loading="lazy"
                  />
                </div>
              )}
              <div class="card__body">
                <h3 style="font-size:1.25rem">{s.name}</h3>
                <p style="margin-top:12px">{s.blurb}</p>
                <ul class="ticklist" style="margin-top:16px">
                  {s.items.map((i) => (
                    <li><Icon name="tick" size={16} /><span style="font-size:.9375rem">{i}</span></li>
                  ))}
                </ul>
                <a class="card__link" href={`/services/${s.slug}/`}>
                  Read more <Icon name="arrow" size={16} />
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>


  <Reviews seed="services" mist={false} />
  <CtaBand />
</Base>
