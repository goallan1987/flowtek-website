---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import Schema from '../components/Schema.astro';
import { business } from '../data/business.js';

interface Props {
  title: string;
  description: string;
  page?: 'home' | 'service' | 'suburb' | 'generic';
  serviceSlug?: string;
  suburbSlug?: string;
  smsSuburb?: string;
  faq?: { q: string; a: string }[];
  noindex?: boolean;
}
const {
  title,
  description,
  page = 'generic',
  serviceSlug,
  suburbSlug,
  smsSuburb,
  faq,
  noindex = false,
} = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, business.site).href;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="theme-color" content="#2A4088" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="geo.region" content="AU-QLD" />
    <meta name="geo.placename" content="Yeppoon, Queensland" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/flowtek-services-logo.png" />

    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/img/flowtek-services-logo.png', business.site).href} />
    <meta name="twitter:card" content="summary" />

    <Schema page={page} url={path} serviceSlug={serviceSlug} suburbSlug={suburbSlug} faq={faq} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ActionBar suburb={smsSuburb} />
  </body>
</html>
